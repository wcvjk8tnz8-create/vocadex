# ─────────────────────────────────────────────────────────────
# Vocadex environment
# Copy to .env.local for local development, and set the same
# values in Vercel → Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# Key the teacher types on /teacher to open the dashboard.
# Change this before going live! If this is missing the server falls back to
# the default key "teacher" and /teacher tells you it is not configured.
TEACHER_KEY=change-me-2026

# ── Cloud storage (required on Vercel) ────────────────────────
# Vercel's file system is read-only, so gift requests only survive
# if you connect the free Upstash Redis REST database:
#   1. https://console.upstash.com → create a Redis database
#   2. copy REST URL and REST TOKEN below
# Without these the app still runs, but data lives in memory only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
